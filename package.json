{
  "name": "pivision-mobile",
  "version": "4.2.0-R300",
  "description": "PIVISION — PI Vision R300 emulator, QA toolkit, AF browser, and 569 symbols (incl. MM20)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint www-src --ext .js,.ts,.html",
    "lint:fix": "eslint www-src --ext .js,.ts,.html --fix",
    "format": "prettier --write \"www-src/**/*.{js,ts,html,css,json}\"",
    "format:check": "prettier --check \"www-src/**/*.{js,ts,html,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "ci": "npm run typecheck && npm run test && npm run build",
    "cap:prepare": "node scripts/cap-prepare.mjs",
    "cap:sync": "npm run cap:prepare && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run cap:sync && cap run android"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-html": "^8.1.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "dompurify": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
